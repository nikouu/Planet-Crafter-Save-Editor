@inject SaveSession Session
@implements IDisposable

<div class="dropzone @(_dragOver ? "dropzone-over" : "") @(Session.FileName is not null ? "dropzone-loaded" : "")"
     @ondragenter="OnDragEnter" @ondragenter:preventDefault @ondragenter:stopPropagation
     @ondragleave="OnDragLeave" @ondragleave:preventDefault @ondragleave:stopPropagation
     @ondragover:preventDefault @ondragover:stopPropagation>
    <InputFile OnChange="OnInputFile" accept=".json" class="dropzone-input" id="dropzone-input" />
    @if (Session.FileName is not null)
    {
        <div class="dropzone-loaded-badge" aria-live="polite">
            <svg class="dropzone-loaded-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
            </svg>
            <span class="dropzone-loaded-text">
                <span class="dropzone-loaded-label">Loaded</span>
                <span class="dropzone-loaded-name">@Session.FileName</span>
            </span>
        </div>
    }
    <label for="dropzone-input" class="dropzone-label">
        <span class="dropzone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
            </svg>
        </span>
        <strong class="dropzone-title">Drop your save file here</strong>
        <span class="dropzone-sub">or <span class="dropzone-cta">click anywhere to browse</span></span>
        <span class="dropzone-hint">JSON save file &middot; up to 10&nbsp;MB</span>
    </label>
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="dropzone-error">@_error</p>
    }
</div>

@code {
    private bool _dragOver;
    private string? _error;

    private const long MaxBytes = 10 * 1024 * 1024;

    protected override void OnInitialized() => Session.OnChanged += StateHasChanged;
    public void Dispose() => Session.OnChanged -= StateHasChanged;

    private void OnDragEnter() => _dragOver = true;
    private void OnDragLeave() => _dragOver = false;

    private async Task OnInputFile(InputFileChangeEventArgs e)
    {
        _dragOver = false;
        _error = null;

        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxBytes)
        {
            _error = $"File is too large ({file.Size:N0} bytes). Max {MaxBytes:N0}.";
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxBytes).CopyToAsync(ms);
            var bytes = ms.ToArray();
            Session.Load(bytes, file.Name);
        }
        catch (FormatException ex)
        {
            _error = $"This doesn't look like a Planet Crafter save: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
    }
}
