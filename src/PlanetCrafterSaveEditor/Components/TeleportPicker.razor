@inject SaveSession Session
@inject SpawnResolver Spawn

<div class="teleport-picker">
    <select @bind="_mode" class="mode-select">
        <option value="spawn">Escape pod</option>
        <option value="player">Another player</option>
        <option value="custom">Custom coords</option>
    </select>

    <div class="dest-slot">
        @if (_mode == "spawn")
        {
            var pod = Spawn.ResolveSpawn(Session.Save!, PlanetId);
            @if (pod is null)
            {
                <span class="dest-label muted">No escape pod for @PlanetId</span>
            }
            else
            {
                <span class="dest-label">@PlanetId pod @pod.PositionString</span>
            }
        }
        else if (_mode == "player")
        {
            var others = Session.Save!.Players()
                .Where(p => p.PlanetId == PlanetId && p.Id != ExcludePlayerId)
                .ToList();
            EnsureDefaultTarget(others);
            @if (others.Count == 0)
            {
                <span class="dest-label muted">No other players on @PlanetId</span>
            }
            else
            {
                <select @bind="_targetPlayer" class="player-select">
                    @foreach (var p in others)
                    {
                        <option value="@p.Id">@p.Name@(p.IsHost ? " (host)" : "")</option>
                    }
                </select>
            }
        }
        else
        {
            <input type="number" step="0.01" placeholder="X" @bind="_x" class="coord" />
            <input type="number" step="0.01" placeholder="Y" @bind="_y" class="coord" />
            <input type="number" step="0.01" placeholder="Z" @bind="_z" class="coord" />
            <label class="snap"><input type="checkbox" @bind="_snapAbove" /> +2 above</label>
        }
    </div>

    <button class="btn primary teleport-btn" disabled="@(!CanApply())" @onclick="Apply">
        Teleport
    </button>

    @if (_warning is not null)
    {
        <p class="warn">@_warning</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string PlanetId { get; set; } = "";
    [Parameter] public long? ExcludePlayerId { get; set; }
    [Parameter, EditorRequired] public EventCallback<Vec3> OnApply { get; set; }

    private string _mode = "spawn";
    private string _targetPlayer = "";
    private float _x;
    private float _y;
    private float _z;
    private bool _snapAbove;
    private string? _warning;

    private void EnsureDefaultTarget(List<PlayerView> others)
    {
        if (others.Count == 0) { _targetPlayer = ""; return; }
        var current = _targetPlayer;
        var validIds = others.Select(p => p.Id.ToString()).ToHashSet();
        if (!string.IsNullOrEmpty(current) && validIds.Contains(current)) return;
        var host = others.FirstOrDefault(p => p.IsHost);
        var pick = host ?? others[0];
        _targetPlayer = pick.Id.ToString();
    }

    private bool CanApply()
    {
        if (Session.Save is null) return false;
        return _mode switch
        {
            "spawn" => Spawn.ResolveSpawn(Session.Save, PlanetId) is not null,
            "player" => !string.IsNullOrEmpty(_targetPlayer),
            "custom" => true,
            _ => false,
        };
    }

    private async Task Apply()
    {
        _warning = null;
        switch (_mode)
        {
            case "spawn":
                var pod = Spawn.ResolveSpawn(Session.Save!, PlanetId);
                if (pod?.PositionString is null) return;
                await OnApply.InvokeAsync(Vec3.Parse(pod.PositionString));
                break;
            case "player":
                if (!long.TryParse(_targetPlayer, out var id)) return;
                var target = Session.Save!.Players().FirstOrDefault(p => p.Id == id);
                if (target is null) return;
                await OnApply.InvokeAsync(Vec3.Parse(target.PositionString));
                break;
            case "custom":
                var y = _snapAbove ? _y + 2.0f : _y;
                if (y < 0 || Math.Abs(_x) > 5000 || Math.Abs(_z) > 5000)
                {
                    _warning = "Coordinates look unusual — double-check before saving.";
                }
                await OnApply.InvokeAsync(new Vec3(_x, y, _z));
                break;
        }
    }
}
