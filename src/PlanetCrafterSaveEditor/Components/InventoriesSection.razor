@inject SaveSession Session
@inject GIdNamer Namer

@if (Session.Save is { } save)
{
    EnsureCache(save);
    var inventories = _inventories!;
    var labels = _labels!;
    var wosById = _wosById!;
    var selected = _selectedId is { } id ? inventories.FirstOrDefault(i => i.Id == id) : null;

    <section class="section">
        <h2>Inventories</h2>
        <div class="inv-layout">
            <ul class="inv-list">
                @foreach (var inv in inventories)
                {
                    var isSel = selected?.Id == inv.Id;
                    <li class="@(isSel ? "selected" : "")" @onclick="() => Select(inv.Id)">
                        <span class="inv-label">@labels[inv.Id]</span>
                        <span class="inv-fill">@inv.WoIds.Count / @inv.Size</span>
                    </li>
                }
            </ul>
            <div class="inv-detail">
                @if (selected is null)
                {
                    <p class="hint">Select an inventory.</p>
                }
                else
                {
                    <InventoryEditor Inventory="selected" AllInventories="inventories" Labels="labels" WosById="wosById" />
                }
            </div>
        </div>
    </section>
}

@code {
    private long? _selectedId;

    private SaveFile? _cachedSave;
    private int _cachedEdit = -1;
    private List<InventoryView>? _inventories;
    private Dictionary<long, string>? _labels;
    private Dictionary<long, WorldObjectView>? _wosById;

    protected override void OnInitialized() => Session.OnChanged += () => InvokeAsync(StateHasChanged);

    private void Select(long id) => _selectedId = id;

    private void EnsureCache(SaveFile save)
    {
        if (ReferenceEquals(_cachedSave, save) && _cachedEdit == Session.EditCounter)
        {
            return;
        }
        _cachedSave = save;
        _cachedEdit = Session.EditCounter;

        var rawInventories = save.Inventories().ToList();
        _wosById = save.WorldObjects().ToDictionary(w => w.Id);
        var players = save.Players().ToList();
        _labels = BuildLabels(rawInventories, players, _wosById);
        _inventories = rawInventories
            .OrderByDescending(i => Rank(players, i.Id))
            .ThenBy(i => _labels[i.Id], StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static int Rank(List<PlayerView> players, long inventoryId)
    {
        foreach (var p in players)
        {
            if (p.InventoryId == inventoryId) return 3;
            if (p.EquipmentId == inventoryId) return 2;
        }
        return 0;
    }

    private Dictionary<long, string> BuildLabels(
        List<InventoryView> invs,
        List<PlayerView> players,
        Dictionary<long, WorldObjectView> wosById)
    {
        var byInv = new Dictionary<long, (PlayerView Player, bool IsEquip)>(players.Count * 2);
        foreach (var p in players)
        {
            byInv[p.InventoryId] = (p, false);
            byInv[p.EquipmentId] = (p, true);
        }

        var result = new Dictionary<long, string>(invs.Count);
        foreach (var inv in invs)
        {
            if (byInv.TryGetValue(inv.Id, out var owner))
            {
                result[inv.Id] = owner.IsEquip
                    ? $"{owner.Player.Name}'s equipment"
                    : $"{owner.Player.Name}'s inventory";
                continue;
            }
            if (wosById.TryGetValue(inv.Id, out var asWo))
            {
                var name = Namer.Display(asWo.GId);
                result[inv.Id] = asWo.HasPosition
                    ? $"{name} at {asWo.PositionString}"
                    : name;
                continue;
            }
            result[inv.Id] = $"Inventory #{inv.Id}";
        }
        return result;
    }
}
