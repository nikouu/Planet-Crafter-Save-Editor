@inject SaveSession Session

@if (Session.Save is { } save)
{
    var meta = save.SaveMeta();
    var players = save.Players().ToList();
    <div class="save-info">
        <div class="save-info-cell">
            <span class="label">File</span>
            <span class="value">@(Session.FileName ?? "(unnamed)")</span>
        </div>
        @if (meta is not null)
        {
            <div class="save-info-cell save-name-cell">
                <span class="label">Save name</span>
                @if (_editing)
                {
                    <span class="save-name-edit">
                        <input class="save-name-input"
                               type="text"
                               @bind="_draft"
                               @bind:event="oninput"
                               @ref="_inputRef"
                               @onkeydown="OnInputKey" />
                        <button class="btn primary save-name-btn" @onclick="() => Save(meta)">Save</button>
                        <button class="btn ghost save-name-btn" @onclick="Cancel">Cancel</button>
                    </span>
                }
                else
                {
                    <span class="save-name-view">
                        <span class="value">@meta.SaveDisplayName</span>
                        <button class="btn ghost save-name-btn" @onclick="() => StartEdit(meta)">Rename</button>
                    </span>
                }
                @if (_error is not null)
                {
                    <span class="save-name-error">@_error</span>
                }
            </div>
            <div class="save-info-cell">
                <span class="label">Planet</span>
                <span class="value">@meta.PlanetId</span>
            </div>
            <div class="save-info-cell">
                <span class="label">Version</span>
                <span class="value">@meta.Version</span>
            </div>
            <div class="save-info-cell">
                <span class="label">Mode</span>
                <span class="value">@meta.Mode</span>
            </div>
        }
        <div class="save-info-cell">
            <span class="label">Players</span>
            <span class="value">
                @foreach (var p in players)
                {
                    <span class="player-badge @(p.IsHost ? "host" : "")">@p.Name</span>
                }
            </span>
        </div>
    </div>
}

@code {
    private bool _editing;
    private string _draft = "";
    private string? _error;
    private ElementReference _inputRef;
    private bool _shouldFocus;

    protected override void OnInitialized() => Session.OnChanged += () => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            try { await _inputRef.FocusAsync(); } catch { }
        }
    }

    private void StartEdit(Models.SaveMetaView meta)
    {
        _draft = meta.SaveDisplayName;
        _error = null;
        _editing = true;
        _shouldFocus = true;
    }

    private void Cancel()
    {
        _editing = false;
        _error = null;
    }

    private void Save(Models.SaveMetaView meta)
    {
        _error = null;
        var trimmed = _draft.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            _error = "Save name cannot be empty.";
            return;
        }
        try
        {
            Session.RenameSave(trimmed);
            _editing = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OnInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var meta = Session.Save?.SaveMeta();
            if (meta is not null) Save(meta);
        }
        else if (e.Key == "Escape")
        {
            Cancel();
        }
    }
}
