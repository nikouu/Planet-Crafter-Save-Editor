@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/" aria-label="Planet Crafter Save Editor — home">
            <svg class="brand-icon" viewBox="0 0 64 64" aria-hidden="true">
                <circle cx="32" cy="32" r="28" fill="none" stroke="#2f8a8a" stroke-width="4" />
                <circle cx="32" cy="32" r="22" fill="#c9572b" />
                <circle cx="24" cy="27" r="4.2" fill="#a64421" opacity="0.7" />
                <circle cx="40" cy="36" r="3.2" fill="#a64421" opacity="0.7" />
                <circle cx="35" cy="22" r="2.2" fill="#a64421" opacity="0.6" />
            </svg>
        </a>
        <a class="repo-link" href="https://github.com/nikouu/Planet-Crafter-Save-Editor" target="_blank" rel="noopener">GitHub</a>
    </header>

    <div class="banner">
        <span><strong>Always back up your save first.</strong> The downloaded file gets a <code>-edited</code> suffix.</span>
        <span class="version-tag">Tested against Planet Crafter <code>2.007</code></span>
    </div>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <span>Made by Niko</span>
        <span class="sep">·</span>
        <a href="https://github.com/nikouu" target="_blank" rel="noopener">GitHub</a>
        <span class="sep">·</span>
        <a href="https://www.nikouusitalo.com/" target="_blank" rel="noopener">Website</a>
    </footer>
</div>
