@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-header-inner">
            <h1>Planet Crafter Save Editor</h1>
            <p class="tagline">Unstuck players, items, and chests — entirely in your browser.</p>
        </div>
        <a class="repo-link" href="https://github.com/nikouu/Planet-Crafter-Save-Editor" target="_blank" rel="noopener">GitHub</a>
    </header>

    <div class="banner">
        <span><strong>Always back up your save first.</strong> The downloaded file gets a <code>-edited</code> suffix.</span>
        <span class="version-tag">Tested against Planet Crafter <code>2.007</code></span>
    </div>

    <main class="app-main">
        @Body
    </main>
</div>
