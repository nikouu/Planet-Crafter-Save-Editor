@page "/"
@inject SaveSession Session

<PageTitle>Planet Crafter Save Editor</PageTitle>

<div class="home">
    <section class="section landing">
        <h1>Planet Crafter Save Editor</h1>
        <p class="tagline">
            Unstuck players, items and chests in your Planet Crafter save. Drop in your save file,
            point and click to teleport, edit inventories and download the result. Everything runs
            in your browser — your save never leaves your machine.
        </p>
    </section>

    <section class="section issue-callout">
        <div class="issue-callout-row">
            <span class="issue-callout-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </span>
            <div class="issue-callout-text">
                <strong>Hit a bug?</strong>
                <span>
                    Unaffiliated fan project — not made or maintained by the Planet Crafter devs (Miju Games).
                    But it is made by <a href="https://github.com/nikouu" target="_blank" rel="noopener noreferrer">Niko</a> ❤️
                </span>
            </div>
            <a class="btn primary issue-callout-link"
               href="https://github.com/nikouu/Planet-Crafter-Save-Editor/issues/new/choose"
               target="_blank"
               rel="noopener noreferrer">
                Report a bug on GitHub
            </a>
        </div>
    </section>

    <section class="section">
        <h2>Load a save</h2>
        <DropZone />
        <HelpPanel />
    </section>

    @if (Session.Save is not null)
    {
        <SaveInfoStrip />
        <PlayersSection />
        <WorldObjectsSection />
        <InventoriesSection />
    }
</div>

<DownloadBar />

@code {
    protected override void OnInitialized() => Session.OnChanged += () => InvokeAsync(StateHasChanged);
}
